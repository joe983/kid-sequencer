# OPTIONAL overrides for the Stripe price IDs.
#
# The price IDs are committed as defaults in index.js (the TEST-mode prices from
# `npm run setup:stripe`), so you normally DON'T need this file at all.
#
# Use it only to override those defaults without editing code — e.g. to point at
# LIVE-mode prices for production. Copy to functions/.env and fill in the IDs you
# want to use. Values here take precedence over the committed defaults.
#
# Real SECRETS (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STABILITY_API_KEY) are
# NEVER kept here — set them with: firebase functions:secrets:set <NAME>

# STRIPE_PRICE_ID=price_xxx          # Pro £4.99/mo
# TOPUP_AI10_PRICE=price_xxx
# TOPUP_AI25_PRICE=price_xxx
# TOPUP_AI50_PRICE=price_xxx
# TOPUP_SLOTS20_PRICE=price_xxx
# TOPUP_SLOTS50_PRICE=price_xxx
