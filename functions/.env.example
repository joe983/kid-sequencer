# Non-secret Stripe config for Cloud Functions (firebase-functions params).
# Copy to functions/.env and fill in the one-off top-up price IDs printed by
# `npm run setup:stripe`. These are PRICE IDS (price_…), not secrets.
#
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID,
# STABILITY_API_KEY) are NOT kept here — set them with:
#   firebase functions:secrets:set <NAME>

TOPUP_AI10_PRICE=price_xxx
TOPUP_AI25_PRICE=price_xxx
TOPUP_AI50_PRICE=price_xxx
TOPUP_SLOTS20_PRICE=price_xxx
TOPUP_SLOTS50_PRICE=price_xxx
