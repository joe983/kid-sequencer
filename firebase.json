{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "samples/drums/**",
      "samples/melodic/**",
      "scan-tests.html",
      "scan-fixtures/**"
    ],
    "rewrites": [
      { "source": "/02", "destination": "/index.html" },
      { "source": "/02/**", "destination": "/index.html" },
      { "source": "/03", "destination": "/index.html" },
      { "source": "/03/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "{/,/02,/02/**,/03,/03/**,**/*.html,/js/**}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/school-music-run/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
