rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId} {

      // The AI engine now renders from the sequence data alone, so nothing is
      // uploaded by the client any more (the old seed-WAV flow is gone). Writes
      // are closed; existing/legacy files can still be read by their owner.
      match /seeds/{seedId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Generated AI tracks. Written only by the Admin SDK (which bypasses
      // these rules); clients may read their own.
      match /tracks/{trackId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
