rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own profile (so the app can check their tier).
    // Only admins write the tier field — do that via Firebase Console.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Paid users can read/write their own saved sequences.
      match /sequences/{seqId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Worksheet-scanner diagnostics (?scandebug=1 → the panel's Send button).
      // Same auth scope as sequences — a user only ever touches their own — and
      // kept OUT of sequences/ so debug logs never show up in the Load sheet.
      match /scanlogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---------------------------------------------------------------
    // Public leaderboard for the "Late for Music Class" runner game
    // (school-brand-game-app). Isolated from /users — anyone may READ
    // the board; CREATE is allowed only for well-formed rows; no client
    // edits or deletes. Added 2026-08-19.
    // ---------------------------------------------------------------
    match /runnerScores/{scoreId} {
      allow read: if true;
      allow create: if isValidRunnerScore();
      allow update, delete: if false;
    }

    function isValidRunnerScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'level', 'score', 'look', 'sortKey', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 10
        && d.level is int && d.level >= 0 && d.level <= 100000
        && d.score is int && d.score >= 0 && d.score <= 1000000000
        && d.sortKey is int
        && (!('look' in d.keys()) || d.look is map)
        && d.createdAt == request.time;
    }
  }
}
