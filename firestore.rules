rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own profile (so the app can check their tier).
    // Only admins write the tier field — do that via Firebase Console.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Paid users can read/write their own saved sequences.
      match /sequences/{seqId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Worksheet-scanner diagnostics (?scandebug=1 → the panel's Send button).
      // Same auth scope as sequences — a user only ever touches their own — and
      // kept OUT of sequences/ so debug logs never show up in the Load sheet.
      match /scanlogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
